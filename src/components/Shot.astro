---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	caption?: string;
	density?: number;
}

const { name, alt, caption, density = 1.5 } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', {
	eager: true,
});
const file = files[`../assets/screenshots/${name}.png`];
if (!file) throw new Error(`Unknown screenshot: ${name}`);
const src = file.default;
const width = Math.round(src.width / density);
---

<figure class="shot not-content">
	<Image
		{src}
		{alt}
		{width}
		widths={[width, width * 2]}
		sizes={`(max-width: ${width}px) 100vw, ${width}px`}
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.shot {
		margin-block: 1.5rem;
	}
	.shot :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		border-radius: 6px;
		border: 1px solid var(--sl-color-gray-5);
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
