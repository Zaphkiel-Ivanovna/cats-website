{
	"overview": {
		"title": "Visitors and page views",
		"description": "Unique visitors and page views, bots excluded",
		"filters": [
			{
				"key": "event",
				"operation": "eq",
				"type": "string",
				"value": "pageview"
			},
			{
				"key": "bot",
				"operation": "eq",
				"type": "boolean",
				"value": false
			},
			{
				"key": "status",
				"operation": "eq",
				"type": "number",
				"value": 200
			}
		],
		"calculations": [
			{
				"operator": "uniq",
				"key": "visitor",
				"keyType": "string",
				"alias": "visitors"
			},
			{
				"operator": "count",
				"alias": "pageviews"
			}
		]
	},
	"daily": {
